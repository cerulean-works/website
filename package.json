{
    "name": "cerulean-website",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix --deny-warnings .",
        "preview": "astro preview",
        "preview:cloudflare": "pnpm build && wrangler dev",
        "deploy": "pnpm build && wrangler deploy",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "^7.3.2",
        "sharp": "^0.35.0"
    },
    "allowScripts": {
        "esbuild": true
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "oxlint": "^1.82.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^1.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "wrangler": "^4.131.1"
    }
}
