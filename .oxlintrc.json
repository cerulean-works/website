{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
    "env": {
        "astro": true,
        "browser": true,
        "node": true
    },
    "rules": {
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
    },
    "ignorePatterns": ["dist/**", ".astro/**", ".wrangler/**"]
}
