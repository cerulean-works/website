---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/theme.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    bodyClass?: string;
}

const { title, description, image, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark-theme">
    <head>
        <BaseHead title={title} description={description} image={image} />
        <script is:inline>
            // Restore the theme before the page paints, avoiding a light flash.
            try {
                const theme = localStorage.getItem("cerulean-theme");
                document.documentElement.classList.toggle(
                    "dark-theme",
                    theme !== "light"
                );
            } catch {
                // Keep the default dark theme when storage is unavailable.
            }
        </script>
    </head>
    <body class:list={["site-theme", bodyClass]}>
        <a class="skip-link" href="#main-content">
            Skip to content
        </a>
        <div class="sky" aria-hidden="true"></div>
        <div class="site-header-wrap">
            <Header />
        </div>
        <slot />
        <Footer />
    </body>
</html>
