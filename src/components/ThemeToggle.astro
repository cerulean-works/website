---
import { Moon, Sun } from "@lucide/astro";
---

<button
    class="theme-preview"
    type="button"
    aria-label="Switch to light mode"
    title="Switch to light mode"
>
    <Sun
        class="theme-sun"
        size={20}
        stroke-width={1.5}
        aria-hidden="true"
        focusable="false"
    />
    <Moon
        class="theme-moon"
        size={20}
        stroke-width={1.5}
        aria-hidden="true"
        focusable="false"
    />
</button>

<script>
    const toggle = document.querySelector<HTMLButtonElement>(".theme-preview");
    const root = document.documentElement;
    const updateLabel = () => {
        const label = root.classList.contains("dark-theme")
            ? "Switch to light mode"
            : "Switch to dark mode";
        toggle?.setAttribute("aria-label", label);
        toggle?.setAttribute("title", label);
    };
    updateLabel();
    let transitionTimer: number | undefined;
    toggle?.addEventListener("click", () => {
        root.classList.add("theme-transitioning");
        window.clearTimeout(transitionTimer);
        transitionTimer = window.setTimeout(
            () => root.classList.remove("theme-transitioning"),
            650
        );
        const dark = root.classList.toggle("dark-theme");
        updateLabel();
        try {
            localStorage.setItem("cerulean-theme", dark ? "dark" : "light");
        } catch {
            // The toggle still works when storage is unavailable.
        }
    });
</script>
