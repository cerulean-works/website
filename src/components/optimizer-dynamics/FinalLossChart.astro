---
/**
 * Final eval loss by optimizer, as a dot plot. `model` selects the proxy
 * (174M) or main (1B) run. Matrix-based and non-matrix optimizers are two
 * series so the family split reads in color and shape.
 */
import DotPlot, { type DotRow } from "../charts/DotPlot.astro";
import type { ChartSeries } from "../charts/chart";
import { proxyFinalLoss, mainFinalLoss, type LossRow } from "./data";

interface Props {
    model?: "proxy" | "main";
}

const { model = "proxy" } = Astro.props;
const main = model === "main";
const data: LossRow[] = main ? mainFinalLoss : proxyFinalLoss;

const series: ChartSeries[] = [
    { key: "matrix", label: "Matrix-based", color: 1, shape: "dot" },
    { key: "nonmatrix", label: "Non-matrix", color: 2, shape: "square" },
];

const rows: DotRow[] = data.map((row) => ({
    label: row.label,
    marks: [{ series: row.matrix ? "matrix" : "nonmatrix", value: row.loss }],
}));

const domain: [number, number] = main ? [2.9, 3.3] : [2.975, 3.06];
const ticks = main ? [2.9, 3.0, 3.1, 3.2, 3.3] : [2.98, 3.0, 3.02, 3.04, 3.06];

const title = main
    ? "Final eval loss by optimizer (main model)"
    : "Final eval loss of different optimizers";
const caption = main
    ? "Main 1B model, lowest-loss learning rate in the sweep. The optimizer ranking matches the proxy model."
    : "Proxy 174M model, 6B tokens (batch 256×2048). Matrix-based optimizers reach lower loss than the non-matrix ones.";
---

<DotPlot
    title={title}
    caption={caption}
    series={series}
    rows={rows}
    domain={domain}
    ticks={ticks}
    format={3}
    axisLabel="final eval loss"
    rowHeader="Optimizer"
/>
