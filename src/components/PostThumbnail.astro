---
import type { CollectionEntry } from "astro:content";
import { resolve } from "node:path";
import sharp from "sharp";

type Thumbnail = CollectionEntry<"blog">["data"]["thumbnail"];

interface Props {
    thumbnail: Thumbnail;
    loading?: "eager" | "lazy";
}

const { thumbnail, loading = "lazy" } = Astro.props;
const { width, height } = await sharp(
    resolve("public", `.${thumbnail.src}`)
).metadata();
---

<img
    class="post-thumbnail artwork-square"
    src={thumbnail.src}
    alt={thumbnail.alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
/>
