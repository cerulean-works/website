---
import PostAuthors from "./PostAuthors.astro";
import { formatPostDate, getBlogPosts, getPostHref } from "../lib/blog";

const posts = (await getBlogPosts()).slice(0, 3);
---

{posts.length > 0 && (
    <section
        class="home-blogs container"
        id="blogs"
        aria-labelledby="blogs-heading"
    >
        <header class="home-blogs-heading">
            <h2 class="editorial-heading" id="blogs-heading">
                Blogs
            </h2>
            <a class="text-link" href="/blog">
                All posts <span aria-hidden="true">→</span>
            </a>
        </header>
        <div class="latest-posts">
            {posts.map((post) => (
                <article class="latest-post">
                    <time
                        class="latest-post-date"
                        datetime={post.data.pubDate.toISOString()}
                    >
                        {formatPostDate(post.data.pubDate)}
                    </time>
                    <h3>
                        <a class="latest-post-link" href={getPostHref(post)}>
                            {post.data.title}
                        </a>
                    </h3>
                    <p class="latest-post-description">
                        {post.data.description}
                    </p>
                    <PostAuthors authors={post.data.author} avatars compact />
                </article>
            ))}
        </div>
    </section>
)}
