---
import PostAuthors from "./PostAuthors.astro";
import {
    formatPostDate,
    getBlogPosts,
    getPostHref,
    getReadingTime,
} from "../lib/blog";

const posts = (await getBlogPosts()).slice(0, 3);
---

{posts.length > 0 && (
    <section
        class="home-blogs container"
        id="blogs"
        aria-labelledby="blogs-heading"
    >
        <header class="home-blogs-heading">
            <h2 class="editorial-heading" id="blogs-heading">
                Blogs
            </h2>
            <a class="text-link" href="/blog">
                All posts <span aria-hidden="true">→</span>
            </a>
        </header>
        <div class="latest-posts">
            {posts.map((post, index) => (
                <article
                    class:list={[
                        "latest-post",
                        { "latest-post-featured": index === 0 },
                    ]}
                >
                    <a
                        class="latest-post-link"
                        href={getPostHref(post)}
                        aria-labelledby={`latest-post-title-${index}`}
                    >
                        <h3 id={`latest-post-title-${index}`}>
                            {post.data.title}
                        </h3>
                        <p class="latest-post-description">
                            {post.data.description}
                        </p>
                    </a>
                    {index === 0 && (
                        <div class="latest-post-meta">
                            <time datetime={post.data.pubDate.toISOString()}>
                                {formatPostDate(post.data.pubDate)}
                            </time>
                            <span>{getReadingTime(post)}</span>
                            <PostAuthors authors={post.data.author} />
                        </div>
                    )}
                </article>
            ))}
        </div>
    </section>
)}
