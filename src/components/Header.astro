---
import ThemeToggle from "./ThemeToggle.astro";
import LogoMark from "./LogoMark.astro";

const isBlog =
    Astro.url.pathname === "/blog" || Astro.url.pathname.startsWith("/blog/");
---

<header class="site-header container">
    <a class="wordmark" href="/" aria-label="Cerulean home" data-header-reveal>
        <LogoMark />
        <span class="wordmark-name">Cerulean</span>
    </a>
    <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/blog/" aria-current={isBlog ? "page" : undefined}>
            Blog
        </a>
        <a class="header-contact" href="#contact" data-header-reveal>
            Contact
        </a>
    </nav>
    <ThemeToggle />
</header>
