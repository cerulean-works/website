---
/**
 * The shell every chart shares: title, legend, the plot (default slot),
 * caption, and a "Show the data" table so no value lives only in a mark.
 */
import { markClasses, type ChartSeries } from "./chart";
import "./charts.css";

interface Props {
    title: string;
    caption?: string;
    series: ChartSeries[];
    /** Legend marks: "mark" for dots and bars, "line" for line charts. */
    legend?: "mark" | "line";
    table: { head: string[]; rows: string[][] };
    class?: string;
}

const {
    title,
    caption,
    series,
    legend = "mark",
    table,
    class: className,
} = Astro.props;
---

<figure class:list={["chart", className]}>
    <p class="chart-title">{title}</p>
    {series.length > 1 && (
        <ul class="chart-legend">
            {series.map((entry) => (
                <li>
                    {legend === "line" ? (
                        <span
                            class:list={[
                                "chart-swatch-line",
                                `chart-c${entry.color}`,
                                { "chart-dashed": entry.dashed },
                            ]}
                            aria-hidden="true"
                        />
                    ) : (
                        <span class:list={markClasses(entry)} aria-hidden="true" />
                    )}
                    {entry.label}
                </li>
            ))}
        </ul>
    )}
    <slot />
    {caption && <figcaption>{caption}</figcaption>}
    <details class="chart-data">
        <summary>Show the data</summary>
        <div class="chart-data-scroll">
            <table>
                <thead>
                    <tr>{table.head.map((cell) => <th scope="col">{cell}</th>)}</tr>
                </thead>
                <tbody>
                    {table.rows.map(([first, ...rest]) => (
                        <tr>
                            <th scope="row">{first}</th>
                            {rest.map((cell) => <td>{cell}</td>)}
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </details>
</figure>
