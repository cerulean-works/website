---
import PostThumbnail from "../../components/PostThumbnail.astro";
import PostAuthors from "../../components/PostAuthors.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    formatPostDate,
    getBlogPosts,
    getPostHref,
    getReadingTime,
} from "../../lib/blog";
import "../../styles/blog.css";

const posts = await getBlogPosts();
const description = "Notes, ideas, and things we’re learning at Cerulean.";
---

<BaseLayout
    title="Blog — Cerulean"
    description={description}
    bodyClass="blog-page blog-index"
>
    <main id="main-content" class="blog-main container">
        <header class="blog-intro">
            <h1>Blog</h1>
            <p>{description}</p>
        </header>
        <div class="post-list">
            {posts.map((post, index) => (
                <article class="post-row">
                    <a
                        href={getPostHref(post)}
                        aria-labelledby={`post-title-${index}`}
                    >
                        <PostThumbnail
                            thumbnail={post.data.thumbnail}
                            loading={index === 0 ? "eager" : "lazy"}
                        />
                    </a>
                    <div class="post-summary">
                        <a href={getPostHref(post)}>
                            <h2 id={`post-title-${index}`}>
                                {post.data.title}
                            </h2>
                            <p class="post-description">
                                {post.data.description}
                            </p>
                        </a>
                        <div class="post-meta">
                            <PostAuthors authors={post.data.author} />
                            <time datetime={post.data.pubDate.toISOString()}>
                                {formatPostDate(post.data.pubDate)}
                            </time>
                            <span>{getReadingTime(post)}</span>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </main>
</BaseLayout>
