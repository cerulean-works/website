---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMark from "../components/LogoMark.astro";
import WorkCard from "../components/WorkCard.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/home.css";
---

<BaseLayout
    title={SITE_TITLE}
    description={SITE_DESCRIPTION}
    image="/images/blog_thumbnails/hero-day.webp"
    bodyClass="home-page"
    headerMode="after-hero"
>
    <main id="main-content">
        <section class="home-hero" data-home-hero aria-label="Our mission">
            <!-- The theme is chosen before paint; CSS shows the matching sky. -->
            <img
                class="home-hero-image home-hero-image-day"
                src="/images/blog_thumbnails/hero-day.webp"
                alt=""
                width="3000"
                height="2000"
                loading="eager"
            />
            <img
                class="home-hero-image home-hero-image-night"
                src="/images/blog_thumbnails/hero-night.webp"
                alt=""
                width="3000"
                height="2000"
                fetchpriority="high"
                loading="eager"
            />
            <h1>
                <span class="mission-line">
                    <LogoMark /> Cerulean is a lab for
                </span>
                <span class="mission-line">breaking down barriers and</span>
                <span class="mission-line">democratizing AI exploration.</span>
            </h1>
        </section>

        <div class="home-body">
            <section class="home-mission" aria-label="About Cerulean">
                <p>
                    We believe in science for everyone, not just the best-funded
                    labs. Maintaining a free and diverse AI landscape requires
                    enabling people from all backgrounds to conduct research.
                    Reliance on six-figure hardware restricts access to one of
                    the most influential areas of research, and we can’t afford
                    that. Scientific progress depends on people being empowered
                    to pursue it.
                </p>
                <p>
                    Cerulean is a student-led research lab that aims to reduce
                    dependence on high-end hardware. Through clever algorithmic
                    and engineering advances, we search for models that learn
                    more from less compute. We treat efficiency as a first-class
                    citizen and believe radical openness accelerates scientific
                    progress for everyone. We build for efficiency in public so
                    others can build on it.
                </p>
                <p>
                    We at Cerulean hope to create a world where human curiosity
                    is knowledge's only boundary. In that world,{" "}
                    <i>the sky's the limit</i>.
                </p>
            </section>

            <section
                class="home-work container"
                id="work"
                aria-labelledby="work-heading"
            >
                <h2 class="editorial-heading" id="work-heading">
                    Our work
                </h2>
                <WorkCard
                    title="Flock"
                    description="An all in one system for model development"
                    image="/images/blog_thumbnails/flock.webp"
                    imageAlt="Seagulls flying together across a blue sky with white clouds"
                    imageWidth={1600}
                    imageHeight={1600}
                />
                <WorkCard
                    title="Fellowship"
                    description="Our approach to training the next generation of researchers"
                    image="/images/blog_thumbnails/fellowship.webp"
                    imageAlt="A dandelion seed head on its stem against a clear blue sky"
                    imageWidth={1600}
                    imageHeight={1600}
                />
                <WorkCard
                    title="Castor"
                    description="Evaluating language model safety from pretraining"
                    image="/images/blog_thumbnails/castor.webp"
                    imageAlt="A white radio telescope dish pointed at a blue sky"
                    imageWidth={1600}
                    imageHeight={1600}
                />
            </section>
            <LatestPosts />
        </div>
    </main>
</BaseLayout>
