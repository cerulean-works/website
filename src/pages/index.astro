---
import LogoMark from "../components/LogoMark.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, getBlogPosts, getPostHref } from "../lib/blog";

const posts = await getBlogPosts();
const latestPost = posts[0];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <main id="main-content" class="home-main container">
        <h1 class="hero-title">
            <span class="hero-brand">
                <LogoMark />
                Cerulean
            </span>{" "}
            is a place for
            <br class="desktop-break" /> curious minds to explore,
            <br class="desktop-break" /> build, and discover.
        </h1>
        <div class="home-columns">
            <section class="intro-copy" aria-label="About Cerulean">
                <p>
                    <span class="small-caps">We believe good things begin</span>{" "}
                    with curiosity. A question worth asking. An idea worth
                    trying. The possibility that something could work a little
                    differently, or a whole lot better.
                </p>
                <p>
                    Cerulean is a space for following those possibilities. We
                    explore ideas, turn them into experiments, and build things
                    that help us understand the world a little more clearly.
                </p>
                <p>
                    Along the way, we’ll share what we’re thinking about, what
                    we’re making, and what we’re learning. Consider this an open
                    notebook. There’s plenty of sky ahead.
                </p>
                <div class="contact-block" id="contact">
                    <p>
                        Have a question or an idea to share?
                        <br />
                        We’d love to hear from you.
                    </p>
                    <a class="text-link" href="mailto:hi@cerulean.works">
                        hi [at] cerulean.works <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
            {latestPost && (
                <aside class="latest" aria-labelledby="latest-heading">
                    <h2 id="latest-heading" class="eyebrow">
                        The latest
                    </h2>
                    <a class="latest-link" href={getPostHref(latestPost)}>
                        <h3>{latestPost.data.title}</h3>
                        <p>{latestPost.data.description}</p>
                        <time
                            class="post-date"
                            datetime={latestPost.data.pubDate.toISOString()}
                        >
                            {formatPostDate(latestPost.data.pubDate)}
                        </time>
                    </a>
                    <a class="all-posts" href="/blog">
                        All posts <span aria-hidden="true">→</span>
                    </a>
                </aside>
            )}
        </div>
    </main>
</BaseLayout>
