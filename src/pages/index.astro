---
import LogoMark from "../components/LogoMark.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, getBlogPosts, getPostHref } from "../lib/blog";

const posts = await getBlogPosts();
const latestPost = posts[0];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <main id="main-content" class="home-main container">
        <h1 class="hero-title">
            <span class="hero-brand">
                <LogoMark />
                Cerulean
            </span>{" "}
            is a lab for
            <br class="desktop-break" /> breaking down barriers and
            <br class="desktop-break" /> democratizing AI exploration.
        </h1>
        <div class="home-columns">
            <section class="intro-copy" aria-label="About Cerulean">
                <p>
                    <span class="small-caps">
                        We believe in science for everyone,
                    </span>{" "}
                    not just the best-funded labs. Maintaining a free and
                    diverse AI landscape requires enabling research for people
                    from all different backgrounds. AI research should be
                    possible before university. AI research should be accessible
                    to community tool-builders. AI research cannot afford to
                    lose ideas to computing costs.
                </p>
                <p>
                    Cerulean is a student-led research lab that aims to reduce
                    the dependence on high-end hardware through clever
                    algorithmic and engineering advances. Our focus is on
                    finding models that learn more from less computation and
                    less inter-accelerator communication. We treat efficiency as
                    a first class citizen and being aggressively open
                    accelerates the science world for all. We build for
                    efficiency in public so others can build on it.
                </p>
                <p>
                    We envision a world where <i>anyone</i> can experiment to
                    their heart's content. In that world,{" "}
                    <span class="sky-signature">sky's the limit.</span>
                </p>
                <div class="contact-block" id="contact">
                    <p>
                        Have a question or an idea to share?
                        <br />
                        We’d love to hear from you.
                    </p>
                    <a class="text-link" href="mailto:hi@cerulean.works">
                        hi [at] cerulean.works <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
            {latestPost && (
                <aside class="latest" aria-labelledby="latest-heading">
                    <h2 id="latest-heading" class="eyebrow">
                        The latest
                    </h2>
                    <a class="latest-link" href={getPostHref(latestPost)}>
                        <h3>{latestPost.data.title}</h3>
                        <p>{latestPost.data.description}</p>
                        <time
                            class="post-date"
                            datetime={latestPost.data.pubDate.toISOString()}
                        >
                            {formatPostDate(latestPost.data.pubDate)}
                        </time>
                    </a>
                    <a class="all-posts" href="/blog">
                        All posts <span aria-hidden="true">→</span>
                    </a>
                </aside>
            )}
        </div>
    </main>
</BaseLayout>
