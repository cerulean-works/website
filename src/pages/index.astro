---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMark from "../components/LogoMark.astro";
import WorkCard from "../components/WorkCard.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { CASTOR_PAPER_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/home.css";
---

<BaseLayout
    title={SITE_TITLE}
    description={SITE_DESCRIPTION}
    image="/images/blog_thumbnails/hero-day.webp"
    bodyClass="home-page"
    headerMode="after-hero"
>
    <main id="main-content">
        <section class="home-hero" data-home-hero aria-label="Our mission">
            <!-- The theme is chosen before paint; CSS shows the matching sky. -->
            <img
                class="home-hero-image home-hero-image-day"
                src="/images/blog_thumbnails/hero-day.webp"
                alt=""
                width="3000"
                height="2000"
                loading="eager"
            />
            <img
                class="home-hero-image home-hero-image-night"
                src="/images/blog_thumbnails/hero-night.webp"
                alt=""
                width="3000"
                height="2000"
                fetchpriority="high"
                loading="eager"
            />
            <h1>
                <span class="mission-line">
                    <LogoMark /> Cerulean is a lab for
                </span>
                <span class="mission-line">breaking down barriers</span>
                <span class="mission-line">to safe, open AI research.</span>
            </h1>
        </section>

        <div class="home-body">
            <section class="home-mission" aria-label="About Cerulean">
                <p>
                    We believe in science for everyone. When AI research stays
                    behind company walls, the knowledge that could move an
                    entire field forward becomes an advantage held by a few. The
                    rest of us are left to repeat the work or depend on what
                    those companies choose to share. Maintaining a free and
                    diverse AI landscape requires labs where that knowledge is
                    developed for the public and remains open for others to
                    build on.
                </p>
                <p>
                    Cerulean is a student-led, non-profit research lab built
                    around that conviction. We aim to show that a lab can thrive
                    without having to turn its research into a business. We do
                    our work in public so that what we learn becomes a starting
                    point for others, who can take it in directions we may never
                    have considered. Our work should make theirs possible.
                </p>
                <p>
                    We at Cerulean hope to create a world where human curiosity
                    is knowledge's only boundary. In that world,{" "}
                    <i>the sky's the limit</i>.
                </p>
            </section>

            <section
                class="home-work container"
                id="work"
                aria-labelledby="work-heading"
            >
                <h2 class="editorial-heading" id="work-heading">
                    Our work
                </h2>
                <WorkCard
                    title="Flock"
                    description="An all in one system for model development"
                    image="/images/blog_thumbnails/flock.webp"
                    imageAlt="Seagulls flying together across a blue sky with white clouds"
                    imageWidth={1600}
                    imageHeight={1600}
                />
                <WorkCard
                    title="Fellowship"
                    description="Our approach to training the next generation of researchers"
                    image="/images/blog_thumbnails/fellowship.webp"
                    href="/blog/fellowship"
                    imageAlt="A dandelion seed head on its stem against a clear blue sky"
                    imageWidth={1600}
                    imageHeight={1600}
                />
                <WorkCard
                    title="Castor"
                    description="Evaluating language model safety from pretraining"
                    image="/images/blog_thumbnails/castor.webp"
                    href={CASTOR_PAPER_URL}
                    imageAlt="A white radio telescope dish pointed at a blue sky"
                    imageWidth={1600}
                    imageHeight={1600}
                />
            </section>
            <LatestPosts />
        </div>
    </main>
</BaseLayout>
