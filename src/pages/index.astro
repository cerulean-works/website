---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMark from "../components/LogoMark.astro";
import WorkCard from "../components/WorkCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/home.css";
---

<BaseLayout
    title={SITE_TITLE}
    description={SITE_DESCRIPTION}
    image="/images/blog_thumbnails/sky-dunes.webp"
    bodyClass="home-page"
    headerMode="after-hero"
>
    <main id="main-content">
        <section class="home-hero" data-home-hero aria-label="Our mission">
            <img
                class="home-hero-image"
                src="/images/blog_thumbnails/sky-dunes.webp"
                alt=""
                width="2000"
                height="3000"
                fetchpriority="high"
                loading="eager"
            />
            <h1>
                <span class="mission-line">
                    <LogoMark /> Cerulean is a lab for
                </span>
                <span class="mission-line">breaking down barriers and</span>
                <span class="mission-line">democratizing AI exploration.</span>
            </h1>
        </section>

        <div class="home-body">
            <section class="home-mission" aria-label="About Cerulean">
                <p>
                    We believe in science for everyone, not just the best-funded
                    labs. Maintaining a free and diverse AI landscape requires
                    enabling research for people from all different backgrounds.
                    AI research should be possible before university. AI
                    research should be accessible to community tool-builders. AI
                    research cannot afford to lose ideas to computing costs.
                </p>
                <p>
                    Cerulean is a student-led research lab that aims to reduce
                    the dependence on high-end hardware through clever
                    algorithmic and engineering advances. Our focus is on
                    finding models that learn more from less computation and
                    less inter-accelerator communication. We treat efficiency as
                    a first class citizen and being aggressively open
                    accelerates the science world for all. We build for
                    efficiency in public so others can build on it.
                </p>
                <p>
                    We envision a world where anyone can experiment to their
                    heart's content. In that world, sky's the limit.
                </p>
            </section>

            <section
                class="home-work container"
                id="work"
                aria-labelledby="work-heading"
            >
                <h2 class="editorial-heading" id="work-heading">
                    Our work
                </h2>
                <WorkCard
                    title="Flock"
                    description="An all in one system for model development"
                    image="/images/blog_thumbnails/flock.webp"
                    imageAlt="A small flock of birds flying in V formation above a cloud"
                    imageWidth={1600}
                    imageHeight={1600}
                />
                <WorkCard
                    title="Castor"
                    description="Evaluating language model safety from pretraining"
                    image="/images/blog_thumbnails/castor.webp"
                    imageAlt="The Milky Way glowing through thin clouds in a night sky"
                    imagePosition="53% center"
                    imageWidth={1800}
                    imageHeight={600}
                />
                <WorkCard
                    title="Fellowship"
                    description="Our approach to training the next generation of researchers"
                    image="/images/blog_thumbnails/fellowship.webp"
                    imageAlt="A dandelion seed head against a clear blue sky"
                    imageWidth={1600}
                    imageHeight={1600}
                />
            </section>
        </div>
    </main>
</BaseLayout>
